# Host 通过此端口访问容器内 Apache 的 80 端口。
ORANGEHRM_HOST_PORT=8080

# 只把 MariaDB 暴露给本机测试进程；容器间连接仍使用 db:3306。
ORANGEHRM_DB_HOST_PORT=3307

# 复制为 .env 后，请将所有 password placeholder 替换为仅供本地使用的密码。
ORANGEHRM_DB_NAME=orangehrm
ORANGEHRM_DB_USER=orangehrm
ORANGEHRM_DB_PASSWORD=replace_with_local_database_password
ORANGEHRM_DB_ROOT_PASSWORD=replace_with_local_root_password

# 以下变量供现有 pytest 切换到本地环境时参考；Compose 不会自动导出它们。
ORANGEHRM_BASE_URL=http://localhost:8080
ORANGEHRM_USERNAME=Admin
ORANGEHRM_PASSWORD=replace_with_local_admin_password

# 以下 Host / Port 供宿主机上的 PyMySQL 使用；数据库名、用户和密码复用上方变量名。
ORANGEHRM_DB_HOST=127.0.0.1
ORANGEHRM_DB_PORT=3307
